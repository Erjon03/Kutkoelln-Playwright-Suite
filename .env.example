# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In CI (GitHub Actions) these come from repository variables / secrets.
# Wrap values containing # or spaces in quotes, e.g. ADMIN_PASSWORD="abc#123"
# (unquoted, everything after # is treated as a comment).
#
# Every key below can also be set per profile as <KEY>_<PROFILE> (e.g. BASE_URL_MYSHOP for PROJECT=myshop);
# that wins over the plain key for that profile only. Plain keys are enough for one shop.
# ---------------------------------------------------------------

# Which project profile to load from ./projects/<PROJECT>.ts
PROJECT=

# Storefront URL of the environment under test (required: client profiles contain no URL)
BASE_URL=

# Optional HTTP basic auth (staging environments behind .htaccess)
HTTP_USERNAME=
HTTP_PASSWORD=

# --- Admin API (test data setup + cleanup of test customers) -----
# Preferred: an integration (Settings > System > Integrations)
ADMIN_CLIENT_ID=
ADMIN_CLIENT_SECRET=
# Alternative: an admin user (password grant)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Store API ---------------------------------------------------
# Sales channel access key. If empty, it is resolved automatically via
# the Admin API by matching the storefront URL against the sales channel domains.
SW_ACCESS_KEY=

# --- Test customers ----------------------------------------------
# Password for every customer the suite registers (required when the profile has none).
# Must meet the shop's password rules.
NEW_ACCOUNT_PASSWORD=

# Valid promotion code for the "valid promotion code reduces total" test. Empty = that test is skipped.
PROMOTION_CODE=

# --- Safety switches ---------------------------------------------
# false = production-safe: skips every test that creates customers, places orders or submits forms.
ALLOW_WRITE_TESTS=true
# Delete customers created by the tests afterwards (needs Admin API credentials)
CLEANUP_TEST_DATA=true
# true = checkout.spec.ts is never collected (no test orders at all)
SKIP_CHECKOUT_TESTS=false
# Do not set here. @sends-message tests (real contact form message) only run via `npm run test:messages`.
# SEND_MESSAGES=

# Browsers to run in addition to chromium + mobile: firefox,webkit
EXTRA_BROWSERS=
